    <node id="Beijing">
      <data key="d0">Beijing</data>
      <data key="d1">location</data>
      <data key="d2">The capital of China during the Ming Dynasty, near which strategically important sections of the Great Wall were built with fired brick and cut stone.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Badaling">
      <data key="d0">Badaling</data>
      <data key="d1">location</data>
      <data key="d2">A section of the Great Wall located about 70 kilometers northwest of Beijing, heavily fortified during the Ming Dynasty and opened to tourists in 1957.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
