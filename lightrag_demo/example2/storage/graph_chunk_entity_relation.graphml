    <node id="Emperor Qin Shi Huang">
      <data key="d0">Emperor Qin Shi Huang</data>
      <data key="d1">person</data>
      <data key="d2">The ruler who unified China in 221 BCE, a period associated with early wall-building along the northern frontier.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Zhu Yuanzhang">
      <data key="d0">Zhu Yuanzhang</data>
      <data key="d1">person</data>
      <data key="d2">The founder of the Ming Dynasty, also known as the Hongwu Emperor, under whom major wall construction began as defense against Mongol tribes.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
