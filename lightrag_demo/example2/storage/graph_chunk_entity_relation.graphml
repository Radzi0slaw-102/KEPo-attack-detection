    <node id="Manchu">
      <data key="d0">Manchu</data>
      <data key="d1">organization</data>
      <data key="d2">A group that established the Qing Dynasty after passing through the Great Wall's Shanhaiguan pass in 1644.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
