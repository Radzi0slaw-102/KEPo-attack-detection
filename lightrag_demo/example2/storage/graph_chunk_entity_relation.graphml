  <graph edgedefault="undirected">
    <node id="Rosetta Stone">
      <data key="d0">Rosetta Stone</data>
      <data key="d1">artifact</data>
      <data key="d2">The Rosetta Stone is a granodiorite stele bearing a decree issued at Memphis in 196 BC on behalf of King Ptolemy V of Egypt, featuring text in Egyptian hieroglyphs, Egyptian Demotic, and Ancient Greek, and is currently held by the British Museum in London.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Memphis">
      <data key="d0">Memphis</data>
      <data key="d1">location</data>
      <data key="d2">Memphis is the city where the decree inscribed on the Rosetta Stone was issued in 196 BC.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Ptolemy V">
      <data key="d0">Ptolemy V</data>
      <data key="d1">person</data>
      <data key="d2">Ptolemy V was the King of Egypt on whose behalf the decree on the Rosetta Stone was issued; he affirmed the royal cult and listed benefits granted to temples.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Hieroglyphs">
      <data key="d0">Egyptian Hieroglyphs</data>
      <data key="d1">concept</data>
      <data key="d2">Egyptian Hieroglyphs is a writing system that had been unreadable for centuries until deciphered using the Rosetta Stone, with the deciphering process involving the analysis of its signs and sounds.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Demotic">
      <data key="d0">Egyptian Demotic</data>
      <data key="d1">concept</data>
      <data key="d2">Egyptian Demotic is one of the three scripts found on the Rosetta Stone, occupying thirty-two lines of text.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Ancient Greek">
      <data key="d0">Ancient Greek</data>
      <data key="d1">concept</data>
      <data key="d2">Ancient Greek is one of the three scripts found on the Rosetta Stone, occupying fifty-four lines of text.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Napoleon Bonaparte">
      <data key="d0">Napoleon Bonaparte</data>
      <data key="d1">person</data>
      <data key="d2">Napoleon Bonaparte was the leader of the French military campaign in Egypt during which the Rosetta Stone was discovered in 1799.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Rosetta">
      <data key="d0">Rosetta</data>
      <data key="d1">location</data>
      <data key="d2">Rosetta, also known as el-Rashid, is a town in the Nile Delta near where the Rosetta Stone was found in 1799.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Nile Delta">
      <data key="d0">Nile Delta</data>
      <data key="d1">location</data>
      <data key="d2">The Nile Delta is the geographic region in Egypt where the town of Rosetta and the Rosetta Stone are located.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Pierre-François Bouchard">
      <data key="d0">Pierre-François Bouchard</data>
      <data key="d1">person</data>
      <data key="d2">Pierre-François Bouchard was an engineer serving with the French expedition who is generally credited with recognizing the significance of the Rosetta Stone.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Capitulation of Alexandria">
      <data key="d0">Capitulation of Alexandria</data>
      <data key="d1">event</data>
      <data key="d2">The Capitulation of Alexandria was the agreement under which the Rosetta Stone passed into British hands after the French surrender in Egypt in 1801.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="British Museum">
      <data key="d0">British Museum</data>
      <data key="d1">organization</data>
      <data key="d2">The British Museum in London has held the Rosetta Stone since 1802, where it remains one of the most visited objects in the collection.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Thomas Young">
      <data key="d0">Thomas Young</data>
      <data key="d1">person</data>
      <data key="d2">Thomas Young was an English polymath who made early progress in deciphering Egyptian hieroglyphs in the 1810s by identifying that some signs recorded the sounds of a royal name.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Jean-François Champollion">
      <data key="d0">Jean-François Champollion</data>
      <data key="d1">person</data>
      <data key="d2">Jean-François Champollion was a French scholar who announced in 1822 that he had cracked the hieroglyphic writing system, building on the work of Thomas Young.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Académie des Inscriptions et Belles-Lettres">
      <data key="d0">Académie des Inscriptions et Belles-Lettres</data>
      <data key="d1">organization</data>
      <data key="d2">The Académie des Inscriptions et Belles-Lettres in Paris is where Jean-François Champollion read his letter announcing the decipherment of hieroglyphs in September 1822.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Memphis Decree">
      <data key="d0">Memphis Decree</data>
      <data key="d1">content</data>
      <data key="d2">The Memphis Decree is the specific text inscribed on the Rosetta Stone, issued by a council of Egyptian priests to affirm the royal cult of Ptolemy V and list benefits granted to temples.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="KV62">
      <data key="d0">KV62</data>
      <data key="d1">artifact</data>
      <data key="d2">KV62 is the designation for the tomb of Tutankhamun, discovered in the Valley of the Kings in November 1922, containing over five thousand artifacts including the gold funerary mask.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Valley of the Kings">
      <data key="d0">Valley of the Kings</data>
      <data key="d1">location</data>
      <data key="d2">The Valley of the Kings is the location where the tomb of Tutankhamun (KV62) was discovered.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Howard Carter">
      <data key="d0">Howard Carter</data>
      <data key="d1">person</data>
      <data key="d2">Howard Carter was the British archaeologist who led the excavation of Tutankhamun's tomb and discovered it in November 1922.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Lord Carnarvon">
      <data key="d0">Lord Carnarvon</data>
      <data key="d1">person</data>
      <data key="d2">Lord Carnarvon, full name George Herbert, 5th Earl of Carnarvon, was the patron of Howard Carter who funded the search for Tutankhamun's tomb and died in Cairo in April 1923.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="George Herbert">
      <data key="d0">George Herbert</data>
      <data key="d1">person</data>
      <data key="d2">George Herbert, 5th Earl of Carnarvon, is the full name of Lord Carnarvon, the patron of the excavation of Tutankhamun's tomb.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Tutankhamun">
      <data key="d0">Tutankhamun</data>
      <data key="d1">person</data>
      <data key="d2">An ancient Egyptian king whose tomb discovery is regarded as one of the most significant archaeological finds of the twentieth century, preserving intact material and insight into New Kingdom royal burial practices.&lt;SEP&gt;Tutankhamun was a pharaoh of the 18th Dynasty who ruled from approximately 1332 BCE to 1323 BCE, son of Akhenaten, whose tomb was discovered by Howard Carter.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000&lt;SEP&gt;doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Akhenaten">
      <data key="d0">Akhenaten</data>
      <data key="d1">person</data>
      <data key="d2">Akhenaten was the pharaoh known for promoting the worship of the sun disk Aten and was the father of Tutankhamun.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Aten">
      <data key="d0">Aten</data>
      <data key="d1">concept</data>
      <data key="d2">Aten is the sun disk whose worship was promoted by the pharaoh Akhenaten.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="18th Dynasty">
      <data key="d0">18th Dynasty</data>
      <data key="d1">organization</data>
      <data key="d2">The 18th Dynasty is the royal lineage to which Tutankhamun and Akhenaten belonged.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Gold Funerary Mask">
      <data key="d0">Gold Funerary Mask</data>
      <data key="d1">artifact</data>
      <data key="d2">The Gold Funerary Mask is an iconic artifact from Tutankhamun's tomb, part of a series of three nested coffins, later moved to the Grand Egyptian Museum.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Egyptian Museum">
      <data key="d0">Egyptian Museum</data>
      <data key="d1">organization</data>
      <data key="d2">A museum in Cairo that initially housed the artifacts from the tomb of Tutankhamun.&lt;SEP&gt;The Egyptian Museum in Cairo initially housed the artifacts from Tutankhamun's tomb before many were moved to the Grand Egyptian Museum.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000&lt;SEP&gt;doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Grand Egyptian Museum">
      <data key="d0">Grand Egyptian Museum</data>
      <data key="d1">organization</data>
      <data key="d2">A museum located near the Giza pyramids where many artifacts from Tutankhamun's tomb, including the gold mask, were later moved.&lt;SEP&gt;The Grand Egyptian Museum near the Giza pyramids currently houses many artifacts from Tutankhamun's tomb, including the gold mask.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000&lt;SEP&gt;doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Giza">
      <data key="d0">Giza</data>
      <data key="d1">location</data>
      <data key="d2">A location near the pyramids where the Grand Egyptian Museum is situated.&lt;SEP&gt;Giza is the location near the pyramids where the Grand Egyptian Museum is situated.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000&lt;SEP&gt;doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Cairo">
      <data key="d0">Cairo</data>
      <data key="d1">location</data>
      <data key="d2">Cairo is the city in Egypt where Lord Carnarvon died in April 1923 and where the Egyptian Museum is located.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Giza Pyramids">
      <data key="d0">Giza Pyramids</data>
      <data key="d1">location</data>
      <data key="d2">The Giza Pyramids are the historical monuments near which the Grand Egyptian Museum is situated.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="New Kingdom">
      <data key="d0">New Kingdom</data>
      <data key="d1">concept</data>
      <data key="d2">A historical period in ancient Egypt regarding which Tutankhamun's tomb provided insight into royal burial practices.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Orville Wright">
      <data key="d0">Orville Wright</data>
      <data key="d1">person</data>
      <data key="d2">One of the Wright brothers who piloted the first flight of the Wright Flyer on December 17, 1903, and lived until 1948.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Wilbur Wright">
      <data key="d0">Wilbur Wright</data>
      <data key="d1">person</data>
      <data key="d2">One of the Wright brothers who piloted the longest flight of the first day, conducted public demonstrations in France in 1908, and died in 1912.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Kitty Hawk">
      <data key="d0">Kitty Hawk</data>
      <data key="d1">location</data>
      <data key="d2">A location in North Carolina near the Kill Devil Hills where the first powered flight of the Wright Flyer took place.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Kill Devil Hills">
      <data key="d0">Kill Devil Hills</data>
      <data key="d1">location</data>
      <data key="d2">A site in North Carolina known for its sandy dunes, steady winds, and soft sand, used by the Wright brothers for glider testing and powered flight.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Wright Flyer">
      <data key="d0">Wright Flyer</data>
      <data key="d1">artifact</data>
      <data key="d2">The first sustained, controlled powered heavier-than-air aircraft, powered by a custom-built engine, with a wingspan of about 12.3 meters and weight of roughly 274 kilograms.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Charlie Taylor">
      <data key="d0">Charlie Taylor</data>
      <data key="d1">person</data>
      <data key="d2">The mechanic who helped the Wright brothers design the custom-built gasoline engine for the Wright Flyer.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="John T. Daniels">
      <data key="d0">John T. Daniels</data>
      <data key="d1">person</data>
      <data key="d2">A local businessman and photographer who captured the famous photograph of the first flight of the Wright Flyer.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Smithsonian National Air and Space Museum">
      <data key="d0">Smithsonian National Air and Space Museum</data>
      <data key="d1">organization</data>
      <data key="d2">A museum in Washington, D.C., where the original 1903 Wright Flyer is preserved and displayed.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Wright Company">
      <data key="d0">Wright Company</data>
      <data key="d1">organization</data>
      <data key="d2">A company founded by the Wright brothers in 1909 to manufacture aircraft commercially.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Ming Dynasty">
      <data key="d0">Ming Dynasty</data>
      <data key="d1">organization</data>
      <data key="d2">A Chinese dynasty that ruled from 1368 to 1644, during which the most visible and best-preserved sections of the Great Wall of China were largely built.&lt;SEP&gt;The Ming Dynasty was a Chinese imperial dynasty that fell in 1644 after the strategic pass of the Great Wall was opened to Manchu forces.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001&lt;SEP&gt;doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-002</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1788940747</data>
      <data key="d6" />
    </node>
    <node id="Great Wall of China">
      <data key="d0">Great Wall of China</data>
      <data key="d1">artifact</data>
      <data key="d2">A massive defensive network of walls, trenches, and natural defenses in China, largely constructed during the Ming Dynasty using fired brick and cut stone.</data>
      <data key="d3">doc-9e1a5454aaa124cfdf6e732f09b9423f-chunk-001</data>
